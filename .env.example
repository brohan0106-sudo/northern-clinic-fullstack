# Copy this file to .env before running in anything beyond local demo use.
PORT=3000
NODE_ENV=development

# MongoDB Atlas / Local Connection URI (Replace <db_password> with your actual database password)
MONGODB_URI=mongodb+srv://brohan0106_db_user:<db_password>@northernclinic01.hb21qmr.mongodb.net/northern_clinic?appName=NorthernClinic01

# Used to sign session JWTs. MUST be replaced with a long random value outside
# a local demo — the checked-in dev default is intentionally weak and is
# rejected by config.js when NODE_ENV=production.
JWT_SECRET=dev-only-secret-change-me

# Minutes of inactivity before a session is forced to re-authenticate.
SESSION_TIMEOUT_MINUTES=15

# Minutes an MFA code remains valid after being issued.
MFA_CODE_TTL_MINUTES=5
